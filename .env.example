# Banco de dados
POSTGRES_DB=erp_core
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# URL do banco para Django (opcional, se o projeto usar dj-database-url)
DATABASE_URL=postgres://erp_user:change_me@postgres:5432/erp_core

# Celery / Cache
CELERY_BROKER_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
